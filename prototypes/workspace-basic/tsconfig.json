{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "jsx": "react-jsx",
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "allowJs": false,
        "types": ["node", "vite/client"],
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "paths": {
            "@basalt/ui": ["../../basalt-app/packages/ui/src/index.ts"]
        }
    },
    "include": ["src", "vite.config.ts", "vitest.config.ts"]
}
