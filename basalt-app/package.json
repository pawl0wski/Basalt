{
    "name": "basalt-app",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "dev": "npm run dev -w packages/app",
        "build": "npm run build -w packages/app",
        "preview": "npm run preview -w packages/app",
        "lint": "eslint . --max-warnings 0",
        "typecheck": "npm run typecheck --workspaces --if-present && tsc -p e2e",
        "test:e2e": "playwright test",
        "test": "vitest run",
        "storybook": "npm run storybook -w packages/ui",
        "build-storybook": "npm run build-storybook -w packages/ui",
        "test:stories": "npm run test:stories -w packages/ui",
        "test:stories:themes": "npm run test:stories:themes -w packages/ui",
        "check:bundle": "node scripts/check-production-bundle.mjs",
        "check:tokens": "npm run check:tokens -w packages/ui",
        "safety-net": "npm run check:tokens && npm run test:stories:themes",
        "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
        "rust:lint": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings",
        "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml --all-targets --all-features",
        "format": "prettier --write \"**/*.{js,jsx,ts,tsx,cjs,mjs,cts,mts,json,css,scss,md,html,yml,yaml}\"",
        "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,cjs,mjs,cts,mts,json,css,scss,md,html,yml,yaml}\"",
        "shadcn": "shadcn",
        "tauri": "tauri"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.1",
        "@playwright/test": "^1.64.1",
        "@tauri-apps/cli": "^2",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.8",
        "@types/node": "^22.20.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "eslint": "^9.39.5",
        "eslint-plugin-react-hooks": "^5.2.0",
        "eslint-plugin-react-refresh": "^0.4.26",
        "globals": "^15.15.0",
        "jsdom": "^26.1.0",
        "prettier": "^3.9.10",
        "shadcn": "^4.4.0",
        "typescript-eslint": "^8.71.2",
        "vitest": "^3.2.7"
    }
}
