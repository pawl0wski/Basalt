{
    "name": "basalt-app",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "dev": "npm run dev -w packages/app",
        "build": "npm run build -w packages/app",
        "preview": "npm run preview -w packages/app",
        "format": "prettier --write \"**/*.{js,jsx,ts,tsx,cjs,mjs,cts,mts,json,css,scss,md,html,yml,yaml}\"",
        "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,cjs,mjs,cts,mts,json,css,scss,md,html,yml,yaml}\"",
        "shadcn": "shadcn",
        "tauri": "tauri"
    },
    "devDependencies": {
        "@tauri-apps/cli": "^2",
        "prettier": "^3.9.10",
        "shadcn": "^4.4.0"
    }
}
