{
    "$schema": "../gen/schemas/desktop-schema.json",
    "identifier": "default",
    "description": "Capability for the main window",
    "windows": ["main"],
    "permissions": [
        "core:default",
        "core:window:allow-destroy",
        "opener:default",
        "dialog:allow-open",
        "fs:allow-read-dir",
        "fs:allow-read-file",
        "fs:allow-write-file",
        "fs:allow-rename",
        "fs:allow-remove",
        "fs:allow-stat",
        "fs:allow-lstat",
        "fs:allow-watch",
        "fs:allow-unwatch",
        "fs:allow-mkdir",
        {
            "identifier": "fs:scope",
            "allow": [{ "path": "$APPCONFIG/basalt.json" }]
        }
    ]
}
