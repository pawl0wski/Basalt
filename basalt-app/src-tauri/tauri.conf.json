{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Basalt",
    "version": "0.1.0",
    "identifier": "com.basalt.app",
    "build": {
        "beforeDevCommand": "npm run dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "npm run build",
        "frontendDist": "../packages/app/dist"
    },
    "app": {
        "windows": [
            {
                "title": "Basalt",
                "width": 1000,
                "height": 700,
                "minWidth": 480,
                "minHeight": 360,
                "resizable": true,
                "decorations": false
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ]
    }
}
